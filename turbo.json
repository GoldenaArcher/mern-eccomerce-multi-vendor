{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", "tsconfig.tsbuildinfo"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "start": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "../../packages/**/src/**",
        "!dist/**",
        "package.json",
        "tsconfig.json"
      ],
      "persistent": true,
      "cache": false
    },
    "start:debug": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "../../packages/**/src/**",
        "!dist/**",
        "package.json",
        "tsconfig.json"
      ],
      "persistent": true,
      "cache": false
    }
  }
}
